{
  "productName": "AI智能病历书写助手",
  "version": "1.0.0",
  "identifier": "com.medai.plugin",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI智能病历书写助手",
        "width": 200,
        "height": 60,
        "minWidth": 200,
        "minHeight": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* ws://localhost:*; script-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "languages": ["zh-CN", "en-US"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "YOUR_UPDATER_PUBLIC_KEY",
      "endpoints": ["http://update-server.internal/medai/{{target}}/{{arch}}/{{current_version}}"]
    }
  }
}
